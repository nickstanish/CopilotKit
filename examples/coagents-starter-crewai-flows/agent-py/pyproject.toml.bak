[build-system]
requires = ["setuptools>=61.0"]
build-backend = "setuptools.build_meta"

[project]
name = "sample_agent"
version = "0.1.0"
description = "Starter"
authors = [
    {name = "Markus Ecker", email = "markus.ecker@gmail.com"}
]
dependencies = [
    "langchain-openai>=0.2.1",
    "langchain-anthropic>=0.2.1",
    "langchain>=0.3.1",
    "openai>=1.51.0",
    "langchain-community>=0.3.1",
    "uvicorn>=0.31.0",
    "python-dotenv>=1.0.1",
    "langchain-core>=0.3.25",
    "langgraph-cli[inmem]>=0.1.64",
    "crewai[tools]==0.118.0",
    "copilotkit>=0.1.42"
]

[project.scripts]
demo = "sample_agent.demo:main"
